generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model Key {
  key String @unique
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  previewUrl  String
  url         String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Script {
  id          Int      @id @default(autoincrement())
  identifier  String   @unique
  title       String
  description String
  url         String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  url         String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
